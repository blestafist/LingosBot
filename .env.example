# LingosBot Configuration

# Browser to use (Chrome, Firefox, Edge)
LINGOS_BROWSER=Chrome

# Path to Chrome binary (optional, leave empty to use system default)
LINGOS_CHROME_BINARY=

# Run browser in headless mode (true/false)
LINGOS_HEADLESS=false

# Number of intentional errors per 100 words
LINGOS_ERRORS_PER_100=10
